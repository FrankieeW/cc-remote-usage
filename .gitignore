# ── Rust ───────────────────────────────────────────────
# cargo 构建产物（根目录）；Cargo.lock 要提交，不要忽略
/target/
**/*.rs.bk
# rustfmt 备份

# ── npm 包 ────────────────────────────────────────────
# 任意层级的 npm 依赖
node_modules/
# postinstall 按平台/架构下载的二进制（darwin-arm64 等）
npm/vendor/
# npm pack 产物
*.tgz

# ── 本机 / 工具状态 ───────────────────────────────────
# 会话工具的本地状态缓存
/.omc/
# release 打包中间产物
/dist/

# ── 运行时数据（别把本机 state/config 带进仓库）────────
# 增量断点 + 失败次数 + 主机名
/state.json
# hosts / 路径等本机配置
/config.json
*.log

# ── 编辑器 ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# ── 密钥 ──────────────────────────────────────────────
.env
.env.*

# ── 系统文件 ──────────────────────────────────────────
.DS_Store
._*
Thumbs.db
